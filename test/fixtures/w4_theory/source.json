  "theory": {
    "locale": "en",
    "role": "unscored_demonstration",
    "title": "Read the price",
    "options": [],
    "steps": [
      {
        "title": "What is already in the pot?",
        "body": "The pot shows 8 BB. That already includes the opponent's 2 BB bet. Your additional call cost is 2 BB."
      },
      {
        "title": "Add only your own call",
        "body": "If 2 BB were added, the called pot would be 10 BB: 8 + 2. This is a calculation, not an action taken in this example."
      },
      {
        "title": "Read the share of the called pot",
        "body": "The price share is 2 / 10 = 20%. It is the fraction of the called pot your call would cost. It is not your hand's chance of winning."
      },
      {
        "title": "Price is one part of a decision",
        "body": "In a no-more-betting, zero-rake comparison, this share is the break-even equity requirement. The opponent's hand and your actual equity are not supplied here. This example does not tell you to Call, Fold or Raise."
      }
    ],
